{
	"version": 6,
	"cmakeMinimumRequired":
	{
		"major": 3,
		"minor": 20,
		"patch": 0
	},
	"configurePresets":
	[
		{
			"name": "debug",
			"displayName": "Debug",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/.cmake/debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"displayName": "Release",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/.cmake/release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	],
	"buildPresets":
	[
		{
			"name": "debug",
			"configurePreset": "debug",
			"jobs": 0
		},
		{
			"name": "release",
			"configurePreset": "release",
			"jobs": 0
		}
	]
}
